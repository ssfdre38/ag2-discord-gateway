# ══════════════════════════════════════════════════════════════════════
# ⚡ AG2 Discord Gateway Configuration
# ══════════════════════════════════════════════════════════════════════

# [Required] Your Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# [Optional] AG2 / Antigravity Conversation Session ID (UUID)
# - Leave blank to automatically create/retain a dedicated session!
# - Or set a specific session UUID to bind directly to an existing AG2 session
AG2_CONVERSATION_ID=

# [Security] Administrator Discord User IDs (comma-separated)
# - Admins can use `!bind <uuid>`, `!session`, `!unbind`, and run full tools.
# - Non-admins are restricted to sandboxed conversational assistance (no raw filesystem/terminal execution).
ADMIN_USERS=

# [Security] Safe Mode (true|false)
# Default: true (sandboxes non-admin users so they cannot run raw actions)
SAFE_MODE=true

# [Persona] Custom System Prompt / Identity
# Injects custom persona/instructions when creating a fresh session (e.g. Ash or gaming2gamers)
SYSTEM_PROMPT=You are gaming2gamers, a sharp, witty AI gaming companion and collaborative assistant.

# [Optional] Require @Bot mention, direct reply, or name prefix to trigger
# Default: true (prevents the bot from talking unless summoned)
REQUIRE_MENTION=true

# [Continuous Auto-Talk] Participate in conversation continuously without @mentions
# Default: false. If true, Ash chats naturally in ALLOWED_CHANNELS / AUTO_TALK_CHANNELS.
AUTO_TALK_MODE=false
AUTO_TALK_CHANNELS=

# [Voice Companion: Auto-Read & Talk-Back] (Requires ENABLE_VOICE=true)
# When Ash is connected to a voice channel:
# - VOICE_AUTO_READ: Reads incoming chat messages aloud via TTS (e.g. 'Daniel says: ...')
# - VOICE_TALK_BACK: Speaks Ash's AI replies aloud directly into the voice channel
# - VOICE_AUTO_JOIN: Automatically joins user voice channels on connect (leaves when empty)
ENABLE_VOICE=true
VOICE_AUTO_READ=true
VOICE_TALK_BACK=true
VOICE_AUTO_JOIN=false
VOICE_AUTO_READ_MAX_CHARS=200
VOICE_TALK_BACK_MAX_CHARS=350

# [Optional] Restrict bot to specific channel IDs (comma-separated). Leave blank for all channels.
ALLOWED_CHANNELS=

# [Optional] Custom bot trigger nicknames (comma-separated, case-insensitive)
BOT_NICKNAMES=gaming2gamers,g2g,ash

# [Optional] Discord message edit rate-limit throttle (milliseconds)
THROTTLE_MS=400

# [Optional] Path to agy.exe (auto-detected if omitted)
# AG2_CLI_PATH=C:\Users\admin\AppData\Local\agy\bin\agy.exe

# [HMB Memory] Hierarchical Memory Bank (64-bit .hmb format from haven-cpp)
# Provides rapid semantic cosine recall without context drift
ENABLE_HMB=true
HMB_VAULT_PATH=data/memory_vault.hmb
HMB_TOP_K=3

# [Outbound Actuation API] Local loopback API for AG2 outbound actuation and MCP bridge
ENABLE_HTTP_API=true
HTTP_PORT=18895
HTTP_HOST=127.0.0.1

# [Visual Generation] Optional external image generation endpoint (e.g. Imagen/Ollama/SD)
# If omitted, Ash uses the built-in high-fidelity vector/raster visual synthesis engine
# IMAGE_GEN_ENDPOINT=http://127.0.0.1:7860/sdapi/v1/txt2img

# [Timeouts] Execution limits for long-running agent tasks
# Time limit for agy.exe per turn in seconds (default: 1800s / 30m; 0 = unlimited)
PRINT_TIMEOUT_SECONDS=1800

# Watchdog timeout for complete process silence/inactivity in milliseconds (default: 300000ms / 5m)
INACTIVITY_TIMEOUT_MS=300000

# Maximum wall-clock ceiling per turn in milliseconds (default: 3600000ms / 60m)
MAX_WALL_CLOCK_TIMEOUT_MS=3600000

# ─── Image Generation & Autonomous Routing (Google Nano Banana <-> Stable Diffusion CPP) ───
# Routing mode: "auto" (default: try Google, fallback to SD on policy/error), "sd", "google", "card"
IMAGE_GEN_ENGINE=auto

# Local Stable Diffusion CPP (DreamShaper8 LCM GGUF)
SD_CLI_PATH=C:\Users\admin\stable-diffusion-cpp\sd-cli.exe
SD_MODEL_PATH=C:\Users\admin\stable-diffusion-cpp\models\DreamShaper8_LCM_q8_0.gguf
SD_TAESD_PATH=C:\Users\admin\stable-diffusion-cpp\models\taesd.safetensors
SD_STEPS=4
SD_CFG_SCALE=1.5
SD_SAMPLING_METHOD=lcm
SD_WIDTH=512
SD_HEIGHT=512
SD_SERVER_URL=http://127.0.0.1:1234

# Google Nano Banana Cloud Engine (Powered natively by agy-cli image-generator — Zero API keys needed)
# Uses Google Ultra / Antigravity authentication through your local agy CLI installation
# Optional custom HTTP endpoint override if desired:
# IMAGE_GEN_ENDPOINT=
